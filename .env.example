NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/productivity
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Coût bcrypt : 10 = serverless (~100-300 ms), 12+ = hosts dédiés
BCRYPT_ROUNDS=10
# Envoi d'emails (vérification + reset) : Resend si configuré, sinon journal console (dev).
RESEND_API_KEY=
RESEND_FROM=Focus <noreply@focus.app>
CLIENT_URL=http://localhost:5173

MAX_FILE_SIZE_MB=25
MAX_WORKSPACE_STORAGE_MB=1024
STORAGE_DIR=./uploads
# local (dev, disque) ou gridfs (serverless/Vercel : binaires dans MongoDB)
STORAGE_PROVIDER=local
