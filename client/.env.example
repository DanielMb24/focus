# Vide = même origine (web / PWA). Pour les applis natives (Tauri/Capacitor),
# mettre l'URL HTTPS du backend déployé, ex. : https://api.example.com
VITE_API_URL=
# URLs de téléchargement des binaires natifs (optionnel : boutons affichés
# dans Paramètres uniquement si renseignées), ex. GitHub Releases.
VITE_APK_URL=
VITE_EXE_URL=
